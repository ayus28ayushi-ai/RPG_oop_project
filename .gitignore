*.dSYM/
*.pdb
*.ilk
core
core.*
*.log

# Editor and IDE files
.vscode/
.idea/
*.swp
*~

# Operating system files
.DS_Store
Thumbs.db

# Phase 2 (uncomment when save files are added)
# saves/